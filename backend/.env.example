# ═══════════════════════════════════════════════════
# TaxFlow AI — Environment Configuration
# Copy this file to `.env` and fill in your values
# ═══════════════════════════════════════════════════

# ── Django Core ─────────────────────────────────
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL for production) ────────
# Leave blank to use SQLite for local dev
DATABASE_URL=
# Or set individual vars:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ── Redis (for Channels + Celery) ──────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Auth ────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Google OAuth 2.0 ───────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Email (for password reset) ─────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── WhatsApp Cloud API (Meta) ──────────────────
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── AI / OCR Engine ───────────────────────────
# Choose: "openai" or "google_vision"
OCR_ENGINE=openai
OPENAI_API_KEY=
GOOGLE_CLOUD_VISION_CREDENTIALS_PATH=

# ── GST Suvidha Provider (GSP) ─────────────────
GSP_PROVIDER_NAME=
GSP_BASE_URL=
GSP_API_KEY=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=

# ── File Storage (S3/GCS) ─────────────────────
# Leave blank to use local filesystem
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# ── Razorpay Billing ──────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Frontend URL (for CORS) ───────────────────
FRONTEND_URL=http://localhost:3000
